# Copiez ce fichier en ".env" et renseignez vos propres valeurs.
# Le fichier ".env" est ignoré par git (voir .gitignore), n'y committez jamais de vraie clé.

# Clé API Anthropic (Claude), utilisée pour l'extraction de mots-clés,
# la classification par sujet et la synthèse multi-sources.
ANTHROPIC_API_KEY=

# Clé API OpenAI, utilisée uniquement en secours si l'appel à Claude
# échoue (clé invalide, panne, quota dépassé...). Optionnelle : si elle
# n'est pas définie, l'appli fonctionne quand même mais sans repli possible.
OPENAI_API_KEY=

# Clé d'accès à la route POST /aggregate, à envoyer dans l'en-tête
# "X-API-Key". Sans cette variable, la route est refusée à tout le monde.
# Générez une valeur longue et aléatoire (ex : openssl rand -hex 32).
ADMIN_API_KEY=

# Connexion PostgreSQL : soit DATABASE_URL directement, soit les variables
# individuelles ci-dessous (valeurs par défaut entre parenthèses).
# DATABASE_URL=postgres://user:password@localhost:5432/quickactu?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=quickactu
DB_SSLMODE=disable
